# =====================================================================
# Shadify Environment Configuration Template
# =====================================================================
# Authoritative documentation: docs/operations/environment-variables.md
# Schema validation: src/lib/env.ts & src/instrumentation.ts
#
# NOTE: In production runtime, all cryptographic secrets must be at least
# 32 characters long and pairwise independent (never reuse the same secret).
# =====================================================================

# Database (PostgreSQL 16 - Neon Serverless)
# Pooled connection string for runtime queries (Neon connection pooler)
DATABASE_URL="postgresql://[user]:[password]@[ep-name]-pooler.[region].aws.neon.tech/shadify?sslmode=require"

# Direct connection string for Prisma schema migrations & DDL operations
DIRECT_URL="postgresql://[user]:[password]@[ep-name].[region].aws.neon.tech/shadify?sslmode=require"

# Next.js App Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Concierge WhatsApp Line (production requires a real 10+ digit business number; placeholders rejected)
NEXT_PUBLIC_CONCIERGE_WHATSAPP="919876543219"
NEXT_PUBLIC_CONCIERGE_WHATSAPP_DISPLAY="+91 98765 43219"

# Admin Authentication & Sessions
ADMIN_PASSWORD_HASH="$2b$10$sample_bcrypt_hash_for_staff"
ADMIN_SESSION_SECRET="super-secret-random-32-character-string-for-session-cookies"

# Dedicated Guest PIN Session Secret (MANDATORY IN PROD: min 32 chars, distinct from ADMIN_SESSION_SECRET)
GUEST_ACCESS_SECRET="independently-generated-secret-min-32-chars-for-guest-pin-cookies"

# Dedicated DPDP Act 2023 Statutory Erasure HMAC Secret (MANDATORY IN PROD: min 32 chars, pairwise distinct)
ERASURE_HMAC_SECRET="independently-generated-secret-min-32-chars-for-erasure-hmac"

# Dedicated Rate Limit Salt Secret for Privacy-Preserving IP Hashing (MANDATORY IN PROD: min 32 chars, pairwise distinct)
RATE_LIMIT_HASH_SECRET="independently-generated-secret-min-32-chars-for-ip-hashing"

# Distributed Rate Limiting (Upstash Redis REST API)
# In production, UPSTASH_REDIS_REST_URL, UPSTASH_REDIS_REST_TOKEN, and RATE_LIMIT_FAIL_CLOSED="true" are required
UPSTASH_REDIS_REST_URL="https://[endpoint].upstash.io"
UPSTASH_REDIS_REST_TOKEN="[token]"
TRUSTED_PROXY_PROVIDER="vercel" # Options: 'vercel' (uses sanitized x-real-ip) or 'cloudflare' (uses cf-connecting-ip)
RATE_LIMIT_FAIL_CLOSED="false" # Set to 'true' in production to guarantee fail-closed enforcement under Redis outages

# Optional Cloudflare Origin Pull Verification (required when TRUSTED_PROXY_PROVIDER="cloudflare")
# CLOUDFLARE_ORIGIN_VERIFY_SECRET="shared-secret-injected-by-cloudflare-transform-rules"

# Cloudflare R2 Media Storage (Zero Egress S3 Compatible)
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="shadify-media"
R2_PUBLIC_DOMAIN="https://media.shadify.in"

# Cloudflare Turnstile Bot Defense (for RSVP & Guestbook forms)
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Staff AI Intake Assistant (defaults to false until data-terms reviewed)
INTAKE_AI_ENABLED="false"
# Optional AI provider configuration for real model evaluations:
# INTAKE_AI_API_KEY="sk-..."
# INTAKE_AI_MODEL="gpt-4o-mini"
# INTAKE_AI_ENDPOINT="https://api.openai.com/v1"
