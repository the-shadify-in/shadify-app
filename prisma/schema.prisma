datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------

enum UserRole {
  super_admin
  staff
  couple
  photographer
}

enum WeddingPlan {
  lite
  premium
  platinum
}

enum WeddingStatus {
  draft
  preview
  published
  archived
  expired
}

enum PhaseOverride {
  pre_wedding
  live
  post_wedding
}

enum MemberRole {
  owner
  editor
  viewer
  photographer
}

enum EventVisibility {
  public
  invited
}

enum GuestSide {
  bride
  groom
  both
}

enum MealPreference {
  pure_veg
  jain
  non_veg
  no_preference
}

enum ShagunStatus {
  declared
  confirmed
  disputed
}

enum PhotoStatus {
  processing
  pending_review
  approved
  rejected
}

enum PhotoVisibility {
  visibility_public   @map("public")
  visibility_family   @map("family")
  visibility_private  @map("private")
}

enum GuestbookStatus {
  pending
  approved
  hidden
}

enum TemplateAudience {
  elders
  friends
  family
  custom
}

enum VipGroup {
  pillars
  brides_tribe
  grooms_squad
  performers
  priest
}

enum OrderStatus {
  created
  paid
  failed
  refunded
  partially_refunded
}

enum ConsentPurpose {
  rsvp_contact
  photo_display
  face_search
}

// ---------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------

model User {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String?         @unique
  phone          String?         @unique
  passwordHash   String?         @map("password_hash")
  fullName       String          @map("full_name")
  role           UserRole        @default(couple)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt      DateTime?       @map("deleted_at") @db.Timestamptz(6)

  memberships    WeddingMember[]
  uploadedPhotos Photo[]         @relation("PhotoUploader")
  auditActions   AuditLog[]

  @@map("users")
}

model ReservedSlug {
  slug String @id

  @@map("reserved_slugs")
}

model Wedding {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug               String          @unique
  customDomain       String?         @unique @map("custom_domain")
  plan               WeddingPlan     @default(lite)
  status             WeddingStatus   @default(draft)
  defaultLocale      String          @default("en") @map("default_locale")
  brideName          String          @map("bride_name")
  groomName          String          @map("groom_name")
  weddingDate        DateTime        @map("wedding_date") @db.Date
  timezone           String          @default("Asia/Kolkata")
  phaseOverride      PhaseOverride?  @map("phase_override")
  themeId            String          @default("royal-crimson") @map("theme_id")
  primaryColor       String?         @default("#8B0000") @map("primary_color")
  accentColor        String?         @default("#C9933A") @map("accent_color")
  monogramText       String?         @map("monogram_text")
  heroPhotoId        String?         @map("hero_photo_id") @db.Uuid
  videoBiteKey       String?         @map("video_bite_key")
  liveStreamUrl      String?         @map("live_stream_url")
  privatePinHash     String?         @map("private_pin_hash")
  upiVpa             String?         @map("upi_vpa")
  showBranding       Boolean         @default(true) @map("show_branding")
  publishedAt        DateTime?       @map("published_at") @db.Timestamptz(6)
  contentExpiresAt   DateTime?       @map("content_expires_at") @db.Timestamptz(6)
  originalsExpireAt  DateTime?       @map("originals_expire_at") @db.Timestamptz(6)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt          DateTime?       @map("deleted_at") @db.Timestamptz(6)

  heroPhoto          Photo?          @relation("WeddingHeroPhoto", fields: [heroPhotoId], references: [id], onDelete: SetNull)
  members            WeddingMember[]
  events             Event[]
  guests             Guest[]
  rsvps              EventRsvp[]
  shagunEntries      ShagunEntry[]
  photos             Photo[]         @relation("WeddingPhotos")
  crewPasses         CrewPass[]
  storyMoments       StoryMoment[]
  vips               Vip[]
  guestbookEntries   GuestbookEntry[]
  inviteTemplates    InviteTemplate[]
  orders             Order[]
  entitlement        Entitlement?
  consents           Consent[]
  erasureRequests    ErasureRequest[]
  auditLogs          AuditLog[]

  @@index([weddingDate], map: "idx_weddings_date")
  @@map("weddings")
}

model WeddingMember {
  weddingId  String     @map("wedding_id") @db.Uuid
  userId     String     @map("user_id") @db.Uuid
  memberRole MemberRole @map("member_role")
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  wedding    Wedding    @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([weddingId, userId])
  @@index([userId], map: "idx_members_user")
  @@map("wedding_members")
}

model Event {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  weddingId     String          @map("wedding_id") @db.Uuid
  eventType     String          @map("event_type")
  title         String
  description   String?
  startsAt      DateTime        @map("starts_at") @db.Timestamptz(6)
  endsAt        DateTime?       @map("ends_at") @db.Timestamptz(6)
  venueName     String          @map("venue_name")
  venueAddress  String?         @map("venue_address")
  venueMapUrl   String?         @map("venue_map_url")
  dressCode     String?         @map("dress_code")
  visibility    EventVisibility @default(invited)
  sortOrder     Int             @default(0) @map("sort_order")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt     DateTime?       @map("deleted_at") @db.Timestamptz(6)

  wedding       Wedding         @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  invites       EventInvite[]
  rsvps         EventRsvp[]
  photos        Photo[]

  @@index([weddingId, startsAt], map: "idx_events_wedding")
  @@map("events")
}

model Guest {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  weddingId    String        @map("wedding_id") @db.Uuid
  displayName  String        @map("display_name")
  phone        String?
  side         GuestSide?
  accessToken  String?       @unique @map("access_token")
  maxPartySize Int           @default(1) @map("max_party_size")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt    DateTime?     @map("deleted_at") @db.Timestamptz(6)

  wedding      Wedding       @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  invites      EventInvite[]
  rsvps        EventRsvp[]

  @@index([weddingId], map: "idx_guests_wedding")
  @@map("guests")
}

model EventInvite {
  eventId String @map("event_id") @db.Uuid
  guestId String @map("guest_id") @db.Uuid

  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest   Guest  @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@id([eventId, guestId])
  @@map("event_invites")
}

model EventRsvp {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  weddingId        String          @map("wedding_id") @db.Uuid
  eventId          String          @map("event_id") @db.Uuid
  guestId          String?         @map("guest_id") @db.Uuid
  respondentName   String          @map("respondent_name")
  respondentPhone  String?         @map("respondent_phone")
  attending        Boolean
  partySize        Int             @default(1) @map("party_size")
  mealPreference   MealPreference? @map("meal_preference")
  needsStay        Boolean         @default(false) @map("needs_stay")
  arrivalNotes     String?         @map("arrival_notes")
  blessingMessage  String?         @map("blessing_message")
  consentAt        DateTime        @default(now()) @map("consent_at") @db.Timestamptz(6)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  wedding          Wedding         @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  event            Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest            Guest?          @relation(fields: [guestId], references: [id], onDelete: SetNull)

  @@index([weddingId, eventId], map: "idx_rsvp_wedding_event")
  @@map("event_rsvps")
}

model ShagunEntry {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  weddingId    String       @map("wedding_id") @db.Uuid
  senderName   String       @map("sender_name")
  amountPaise  BigInt       @map("amount_paise")
  upiRefId     String?      @map("upi_ref_id")
  blessingNote String?      @map("blessing_note")
  status       ShagunStatus @default(declared)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  confirmedAt  DateTime?    @map("confirmed_at") @db.Timestamptz(6)

  wedding      Wedding      @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@index([weddingId, createdAt(sort: Desc)], map: "idx_shagun_wedding")
  @@map("shagun_entries")
}

model Photo {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  weddingId        String          @map("wedding_id") @db.Uuid
  eventId          String?         @map("event_id") @db.Uuid
  uploadedBy       String?         @map("uploaded_by") @db.Uuid
  keyOriginal      String?         @map("key_original")
  keyPreview       String          @map("key_preview")
  keyThumb         String          @map("key_thumb")
  width            Int
  height           Int
  bytesOriginal    BigInt?         @map("bytes_original")
  sha256           String          @db.Char(64)
  status           PhotoStatus     @default(pending_review)
  visibility       PhotoVisibility @default(visibility_public)
  isHighlight      Boolean         @default(false) @map("is_highlight")
  sortOrder        Int             @default(0) @map("sort_order")
  takenAt          DateTime?       @map("taken_at") @db.Timestamptz(6)
  uploadedAt       DateTime        @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  rejectedPurgeAt  DateTime?       @map("rejected_purge_at") @db.Timestamptz(6)

  wedding          Wedding         @relation("WeddingPhotos", fields: [weddingId], references: [id], onDelete: Cascade)
  event            Event?          @relation(fields: [eventId], references: [id], onDelete: SetNull)
  uploader         User?           @relation("PhotoUploader", fields: [uploadedBy], references: [id], onDelete: SetNull)
  heroForWeddings  Wedding[]       @relation("WeddingHeroPhoto")
  storyMoments     StoryMoment[]
  vips             Vip[]

  @@unique([weddingId, sha256])
  @@index([weddingId, status, visibility, uploadedAt(sort: Desc)], map: "idx_photos_feed")
  @@map("photos")
}

model CrewPass {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  weddingId       String    @map("wedding_id") @db.Uuid
  label           String
  tokenHash       String    @unique @map("token_hash")
  pinHash         String?   @map("pin_hash")
  allowedEventIds String[]  @map("allowed_event_ids") @db.Uuid
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  wedding         Wedding   @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@map("crew_passes")
}

model StoryMoment {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  weddingId  String    @map("wedding_id") @db.Uuid
  momentDate DateTime? @map("moment_date") @db.Date
  title      String
  body       String?
  photoId    String?   @map("photo_id") @db.Uuid
  sortOrder  Int       @default(0) @map("sort_order")

  wedding    Wedding   @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  photo      Photo?    @relation(fields: [photoId], references: [id], onDelete: SetNull)

  @@map("story_moments")
}

model Vip {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  weddingId  String   @map("wedding_id") @db.Uuid
  groupLabel VipGroup @map("group_label")
  name       String
  tagline    String?
  photoId    String?  @map("photo_id") @db.Uuid
  linkUrl    String?  @map("link_url")
  sortOrder  Int      @default(0) @map("sort_order")

  wedding    Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  photo      Photo?   @relation(fields: [photoId], references: [id], onDelete: SetNull)

  @@map("vips")
}

model GuestbookEntry {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  weddingId  String          @map("wedding_id") @db.Uuid
  authorName String          @map("author_name")
  message    String
  status     GuestbookStatus @default(pending)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  wedding    Wedding         @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@map("guestbook_entries")
}

model InviteTemplate {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  weddingId String?          @map("wedding_id") @db.Uuid
  audience  TemplateAudience
  locale    String           @default("en")
  body      String

  wedding   Wedding?         @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@map("invite_templates")
}

model Order {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  weddingId        String?     @map("wedding_id") @db.Uuid
  weddingSlugCopy  String      @map("wedding_slug_copy")
  billingName      String      @map("billing_name")
  billingEmail     String?     @map("billing_email")
  billingPhone     String      @map("billing_phone")
  billingAddress   String?     @map("billing_address")
  billingGstin     String?     @map("billing_gstin")
  item             String
  amountPaise      BigInt      @map("amount_paise")
  gstPaise         BigInt      @default(0) @map("gst_paise")
  gateway          String      @default("razorpay")
  gatewayOrderId   String?     @unique @map("gateway_order_id")
  gatewayPaymentId String?     @unique @map("gateway_payment_id")
  status           OrderStatus @default(created)
  invoiceNo        String?     @unique @map("invoice_no")
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  paidAt           DateTime?   @map("paid_at") @db.Timestamptz(6)

  wedding          Wedding?    @relation(fields: [weddingId], references: [id], onDelete: SetNull)

  @@map("orders")
}

model Entitlement {
  weddingId      String   @id @map("wedding_id") @db.Uuid
  maxGuests      Int?     @map("max_guests")
  maxPhotos      Int?     @map("max_photos")
  maxOriginalsGb Decimal? @map("max_originals_gb") @db.Decimal(6, 1)
  videoBite      Boolean  @default(false) @map("video_bite")
  customDomain   Boolean  @default(false) @map("custom_domain")
  faceSearch     Boolean  @default(false) @map("face_search")
  hostingUntil   DateTime @map("hosting_until") @db.Timestamptz(6)

  wedding        Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@map("entitlements")
}

model Consent {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  weddingId     String         @map("wedding_id") @db.Uuid
  subject       String
  purpose       ConsentPurpose
  noticeVersion String         @map("notice_version")
  grantedAt     DateTime       @default(now()) @map("granted_at") @db.Timestamptz(6)
  withdrawnAt   DateTime?      @map("withdrawn_at") @db.Timestamptz(6)

  wedding       Wedding        @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@map("consents")
}

model ErasureRequest {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  weddingId   String    @map("wedding_id") @db.Uuid
  subject     String
  requestedAt DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  wedding     Wedding   @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@map("erasure_requests")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  weddingId String?  @map("wedding_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  detail    Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  wedding   Wedding? @relation(fields: [weddingId], references: [id], onDelete: SetNull)
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([weddingId, createdAt(sort: Desc)], map: "idx_audit_wedding")
  @@map("audit_log")
}
